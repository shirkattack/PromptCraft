{
  "name": "promptcraft",
  "version": "1.0.0",
  "description": "AI-powered prompt optimization platform with FastAPI backend and Next.js frontend",
  "private": true,
  "scripts": {
    "install:web": "cd Web && npm install --legacy-peer-deps",
    "install:api": "cd API && pip install -r requirements.txt",
    "dev:web": "cd Web && npm run dev",
    "dev:api": "cd API && python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8765",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:web": "cd Web && npm run build",
    "start:web": "cd Web && npm start",
    "start:api": "cd API && python -m uvicorn app.main:app --host 127.0.0.1 --port 8765",
    "start": "concurrently \"npm run start:api\" \"npm run start:web\"",
    "lint:web": "cd Web && npm run lint",
    "test:api": "cd API && python -m pytest tests/ -v",
    "clean": "rm -rf Web/node_modules Web/.next API/__pycache__ API/**/__pycache__"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "ai",
    "prompt-optimization",
    "fastapi",
    "nextjs",
    "machine-learning",
    "typescript",
    "python"
  ],
  "author": "PromptCraft Team",
  "license": "MIT"
}