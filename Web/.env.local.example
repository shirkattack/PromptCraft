# API Configuration
# The URL where the PromptCraft API is running
# For local development, use: http://localhost:8000/api/v1
# For production, use your deployed API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# API Key (Optional - only needed if REQUIRE_API_KEY=true on backend)
# This must match the API_KEY in your backend .env file
# Leave empty if API key authentication is disabled
NEXT_PUBLIC_API_KEY=

# Optional: Enable debug mode
NEXT_PUBLIC_DEBUG=false
