# ---------------------------------------------------------------------------
# Python (API/)
#
# Directory patterns are anchored to API/ on purpose. Unanchored rules such as
# `lib/` or `build/` match at any depth, and silently excluded Web/lib/ (the
# entire frontend API client) from the repository.
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
API/.Python
API/build/
API/develop-eggs/
API/dist/
API/downloads/
API/eggs/
API/.eggs/
API/lib/
API/lib64/
API/parts/
API/sdist/
API/var/
API/wheels/
API/share/python-wheels/
API/pip-wheel-metadata/
API/.installed.cfg
API/MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
*.cover
htmlcov/

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# Environment variables
.env
.env.local
.env.*.local

# Database
*.db
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Node.js / Next.js (Web/ and the root convenience scripts)
#
# package-lock.json is committed: it is what makes `npm ci` possible and keeps
# installs reproducible.
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
.next/
out/
next-env.d.ts
*.tsbuildinfo
.vercel
coverage/
.nyc_output

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log

# Misc
.cache/
.temp/
.tmp/
