# Ollama Configuration (Required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3
OLLAMA_KEEP_ALIVE=5m

# Default Model Settings
DEFAULT_MODEL_NAME=llama3.2:latest
DEFAULT_MODEL_PROVIDER=ollama
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=1000
DEFAULT_SYNTHETIC_DATA_SIZE=10

# Database
DATABASE_URL=sqlite:///./app.db

# Logging
LOG_LEVEL=INFO

# App settings
APP_NAME=PromptCraft API - Ollama Edition
DEBUG=false

# CORS - origins allowed to call the API from a browser
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Host header check. "*" accepts any Host, which is what you want for a server
# bound to localhost. When deploying behind a public hostname, list it here
# instead, e.g. ALLOWED_HOSTS=["api.example.com"] -- anything not listed gets a
# 400 before it reaches a route.
ALLOWED_HOSTS=["*"]

# Largest page size any list endpoint will return
MAX_PAGE_SIZE=500

# How many optimization results to keep in the in-process history buffer
# (used for the total_processing_time analytics figure)
OPTIMIZATION_HISTORY_SIZE=100

# Security (Optional - for API key authentication)
# Set REQUIRE_API_KEY=true and provide an API_KEY to enable authentication
# Leave REQUIRE_API_KEY=false for local development without auth
REQUIRE_API_KEY=false
API_KEY=your-secret-api-key-change-this-in-production
